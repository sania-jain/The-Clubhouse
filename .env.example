# Copy this file to .env.local and fill in the values from the Supabase
# dashboard (the "Connect" button at the top of the project). Leave them
# blank to run on mock data.
# Never put the secret / service_role key here — this file's values ship
# to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
